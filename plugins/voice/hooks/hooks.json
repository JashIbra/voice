{
  "description": "Voice mode: a new message from the user cuts off the answer still being spoken, and a reply that was never spoken is sent back to be spoken.",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "killall say 2>/dev/null; exit 0",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/require-speech.py\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
